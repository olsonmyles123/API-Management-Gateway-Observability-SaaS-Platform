# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=*

# PostgreSQL (Control Plane Metadata)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apigateway_db
# For SQLite fallback during lightweight testing or local dev without PostgreSQL running:
# DATABASE_URL=sqlite+aiosqlite:///./apigateway.db

# Redis 7 (Caching, Sliding-Window Rate Limiting, Streams)
REDIS_URL=redis://localhost:6379/0

# ClickHouse (OLAP Telemetry Logs & Aggregations)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false

# Gateway Proxy Tuning
PROXY_TIMEOUT_SECONDS=30.0
MAX_KEEPALIVE_CONNECTIONS=100
MAX_CONNECTIONS=500

# Background Worker & Alerting Config
TELEMETRY_BATCH_SIZE=100
TELEMETRY_FLUSH_INTERVAL_MS=500
ALERT_EVAL_INTERVAL_SECONDS=30
